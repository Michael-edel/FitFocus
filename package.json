{
  "name": "fitfocus",
  "private": true,
  "version": "2.0.0-architecture.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/generate-build-info.mjs",
    "build": "vite build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "check:admin-guards": "node scripts/check-admin-guards.mjs",
    "prebuild": "node scripts/generate-build-info.mjs && node scripts/check-admin-guards.mjs",
    "pretypecheck": "node scripts/generate-build-info.mjs && node scripts/check-admin-guards.mjs",
    "generate:build-info": "node scripts/generate-build-info.mjs",
    "check:api-invariants": "node scripts/check-api-invariants.mjs",
    "check:auth-scope": "node scripts/check-auth-scope.mjs",
    "check:schema": "python scripts/check-schema-parity.py",
    "check:privacy": "python scripts/check-privacy-coverage.py",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "migrate:local": "node -e \"console.log('Migrations run in browser on startup via storage/migrations.ts')\"",
    "typecheck:domain-strict": "tsc --project tsconfig.domain-strict.json"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.563.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "stripe": "^14.25.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "dompurify": "^3.4.11"
  }
}
