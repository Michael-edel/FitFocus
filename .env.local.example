# Local development env (Docker/Vite)
# Copy to .env and/or .env.local and fill real values.

# ---- Google OAuth (Google Identity Services) ----
# For LOCAL (http://localhost:5173)
VITE_GOOGLE_CLIENT_ID_LOCAL=CHANGE_ME_LOCAL_CLIENT_ID.apps.googleusercontent.com

# For PROD (https://<your-domain>)
VITE_GOOGLE_CLIENT_ID_PROD=CHANGE_ME_PROD_CLIENT_ID.apps.googleusercontent.com

# ---- Session signing (HS256) ----
# IMPORTANT: use a long random string in real usage.
AUTH_JWT_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET

# ---- AI key (optional for /api/ai in dev) ----
# Leave empty if you don't use AI features locally.
GEMINI_API_KEY=

# ---- Web Push (PWA notifications) ----
VITE_PUSH_VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
PUSH_VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
PUSH_VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
PUSH_VAPID_SUBJECT=mailto:support@example.com

# One-time bootstrap admin (only if there are no admins yet)
BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# Scheduled cleanup endpoint. Use the same value in Cloudflare Pages env var
# CRON_SECRET and GitHub repository secret FITFOCUS_CLEANUP_SECRET.
CRON_SECRET=CHANGE_ME_LONG_RANDOM_CLEANUP_SECRET

# ---- Huawei Health API (server-only) ----
# Create these values in Huawei Developer Console and add them as Cloudflare
# Pages production secrets. Do not expose them to Vite/client code.
HUAWEI_HEALTH_CLIENT_ID=CHANGE_ME_HUAWEI_CLIENT_ID
HUAWEI_HEALTH_CLIENT_SECRET=CHANGE_ME_HUAWEI_CLIENT_SECRET
HUAWEI_HEALTH_SCOPES=CHANGE_ME_HUAWEI_SCOPES
# Optional: defaults to <APP_URL>/api/wearable/huawei/callback when omitted.
HUAWEI_HEALTH_REDIRECT_URI=
# Optional: defaults to AUTH_JWT_SECRET when omitted. Use a separate long secret
# in production to encrypt stored Huawei refresh/access tokens.
HUAWEI_HEALTH_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM_HUAWEI_TOKEN_SECRET
