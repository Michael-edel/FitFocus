# Wrangler local vars for Cloudflare Pages Functions (copy to .dev.vars)
# Used by /functions/api/auth/google.ts to validate Google ID token (aud claim)
GOOGLE_CLIENT_ID=CHANGE_ME

# Our session cookie ff_session is a HS256 JWT signed with this secret
AUTH_JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# Web Push / PWA notifications
PUSH_VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_KEY
PUSH_VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_KEY
PUSH_VAPID_SUBJECT=mailto:support@fitfocus.pages.dev

# Scheduled cleanup endpoint. Use the same value in Cloudflare Pages env var
# CRON_SECRET and GitHub repository secret FITFOCUS_CLEANUP_SECRET.
CRON_SECRET=CHANGE_ME_LONG_RANDOM_CLEANUP_SECRET
